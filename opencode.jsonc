{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mistral": {
      "npm": "@ai-sdk/mistral",
      "name": "Mistral",
      "api_key": "MISTRAL_API_KEY",
      "models": {
        "mistral-large-latest": {
          "name": "Mistral Large 2"
        }
      }
    }
  },
  "small_model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "kill": "allow"
  }
}

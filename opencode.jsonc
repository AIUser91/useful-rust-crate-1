{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "mistral": {
      "npm": "@ai-sdk/mistral",
      "name": "Mistral",
      "api_key": "MISTRAL_API_KEY",
    },
    "logfare": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Logfare.ai",
      "api_key": "LOGFARE_API_KEY",
      "options": {
        "baseURL": "https://logfare.ai/v1"
      },
      "models": {
        "kimi-k3": { "name": "Kimi K3" }
      }
    },
  },
  "small_model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "kill": "allow"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "sambanova": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "SambaNova",
      "options": {
        "baseURL": "https://api.sambanova.ai/v1"
      },
      "api_key": "SAMBANOVA_API_KEY",
      "models": {
        "Meta-Llama-3.1-70B-Instruct": {
          "name": "Llama 3.1 70B"
        }
      }
    }
  },
  "small_model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "kill": "allow"
  }
}

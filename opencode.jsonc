{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://api.cerebras.ai/v1",
        "compatibility": "compatible"
      },
      "models": {
        "llama3.3-70b": {
          "name": "Llama 3.3 70B"
        }
      }
    }
  },
  "small_model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "kill": "allow"
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "openai": {
      "options": {
        "baseURL": "https://api.cerebras.ai/v1"
      },
      "api_key": "CEREBRAS_API_KEY"
    }
  },
  "small_model": "opencode/big-pickle",
  "permission": {
    "edit": "allow",
    "write": "allow",
    "bash": "allow",
    "webfetch": "allow",
    "read": "allow",
    "grep": "allow",
    "list": "allow",
    "question": "deny",
    "kill": "allow"
  }
}
